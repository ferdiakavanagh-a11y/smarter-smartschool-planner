# Copy to "credentials.yml" and fill in. Never share or commit it.

# Smartschool username
username: "your.username"

# Smartschool password
password: "your-password"

# School address WITHOUT "https://", e.g. yourschool.smartschool.be
main_url: "yourschool.smartschool.be"

# Misnamed field: either the answer to the login security question (usually your birthdate,
# written as YYYY-MM-DD, e.g. 2008-05-14), or a TOTP secret for real 2FA.
# Leave as REPLACE_ME if your login asks for neither.
mfa: "REPLACE_ME"

# OPTIONAL: Gemini API key for deadline detection; choose Local or Gemini in Settings.
# When Gemini is selected, task text is sent in cached batches. Free key: https://aistudio.google.com/apikey
# Keep it private like a password.
gemini_api_key: ""

# OPTIONAL, advanced: override the detail endpoint template.
# Placeholders: {platform_id} {user_id} {id} {type} {date}
planner_detail_url: ""
