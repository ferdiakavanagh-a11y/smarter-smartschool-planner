# Copy to "credentials.yml" and fill in. Never share or commit it.

# Smartschool username
username: "your.username"

# Smartschool password
password: "your-password"

# School address WITHOUT "https://", e.g. yourschool.smartschool.be
main_url: "yourschool.smartschool.be"

# Misnamed field: either the answer to the login security question (often your birthdate),
# or a TOTP secret for real 2FA (also needs `pip install pyotp`).
# Unsure? Run debug_verification_question.py to see the question text.
mfa: "REPLACE_ME"

# OPTIONAL: Gemini API key for deadline detection (the regex parser is off, see USE_REGEX_DEADLINE_PARSER in sync.py).
# Task body text is sent to Gemini in one cached request per sync. Free key: https://aistudio.google.com/apikey
# Keep it private like a password.
gemini_api_key: ""

# OPTIONAL, advanced: override the detail endpoint template.
# Placeholders: {platform_id} {user_id} {id} {type} {date}
planner_detail_url: ""
