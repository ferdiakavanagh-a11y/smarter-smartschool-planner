# Copy this file to "credentials.yml" (same folder) and fill in your details.
# credentials.yml is gitignored / should never be shared or committed anywhere.

# Your Smartschool username (same one you use to log in on the website)
username: "your.username"

# Your Smartschool password
password: "your-password"

# Your school's Smartschool address WITHOUT the "https://" part -
# e.g. if you log in at https://yourschool.smartschool.be, put just:
main_url: "yourschool.smartschool.be"

# This field has a confusing name in the underlying library - it's used for TWO
# different things depending on what your account needs:
#   1. A "security question" Smartschool sometimes asks at login (often your
#      birthdate) - if that's what you see, put the answer to that question here.
#   2. Real 2FA (TOTP) - if your account has an authenticator app set up, put the
#      TOTP secret here instead (tell Claude, since this also needs `pip install pyotp`).
# Not sure which applies to you? Run debug_verification_question.py first - it
# logs in and shows you the exact question text without guessing an answer.
mfa: "REPLACE_ME"

# OPTIONAL, but needed for deadline detection to work at all right now (the
# free built-in text parser is switched off by default - see USE_REGEX_DEADLINE_PARSER
# in sync.py). When set, each assignment's real body text is sent to Google's
# Gemini API (all in one batched request per sync, cached so repeats are free)
# to find deadlines like "De deadline is VRIJDAG 25 SEPTEMBER". Get a free key
# at https://aistudio.google.com/apikey ("Get API key" in the sidebar there).
# Keep this file private - this key is as sensitive as a password.
gemini_api_key: ""

# OPTIONAL, advanced. Leave blank - this is only for if the automatic
# detection of Smartschool's per-task detail endpoint doesn't work for your
# school and you (or Claude) have found the correct URL by hand. If set, this
# exact template is used instead of guessing, with these placeholders filled
# in: {platform_id} {user_id} {id} {type} {date}
planner_detail_url: ""
